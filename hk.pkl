amends "package://github.com/jdx/hk/releases/download/v1.20.0/hk@1.20.0#/Config.pkl"

local linters = new Mapping<String, Step> {
    ["cargo-fmt"] {
        glob = "src-tauri/**/*.rs"
        check = "cd src-tauri && cargo fmt --check"
        fix = "cd src-tauri && cargo fmt"
    }
    ["clippy"] {
        glob = "src-tauri/**/*.rs"
        check = "cd src-tauri && cargo clippy --lib -- -D warnings"
        exclusive = true // run clippy in isolation to avoid conflicts
    }
}

hooks {
    ["pre-commit"] {
        fix = true    // automatically run cargo fmt on files
        stash = "git" // stashes unstaged changes while running fix steps
        steps = linters
    }
    // "fix" and "check" are special steps for `hk fix` and `hk check` commands
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
