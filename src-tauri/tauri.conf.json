{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "educartable-sync",
  "version": "1.0.0",
  "identifier": "net.bombfork.educartable-sync",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Educartable Sync",
        "width": 1000,
        "height": 650,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage"
    ],
    "shortDescription": "Synchronisation de photos depuis Educartable",
    "longDescription": "Application de bureau pour télécharger et synchroniser par lot les photos depuis Educartable vers votre ordinateur.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": null
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "hardenedRuntime": true,
      "frameworks": [],
      "entitlements": null,
      "signingIdentity": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bombfork/educartable-sync/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RDkyQTVEMDEwQ0VEQUUKUldTdTdRd0JYU3JaT09XbDhySTI1SWpKMVowQVBNWDh6c2NmVzJZSnFSL3dQZ0xxelhoMHE5aW4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
