{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "educartable-sync",
  "version": "0.1.0",
  "identifier": "com.atom.educartable-sync",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Educartable Sync",
        "width": 900,
        "height": 650,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "shortDescription": "Synchronisation de photos depuis Educartable",
    "longDescription": "Application de bureau pour télécharger et synchroniser par lot les photos depuis Educartable vers votre ordinateur.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perUser",
        "languages": ["French"],
        "template": null
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "hardenedRuntime": true,
      "frameworks": [],
      "entitlements": null,
      "signingIdentity": null
    },
    "appimage": {
      "bundleMediaFramework": false
    }
  }
}
